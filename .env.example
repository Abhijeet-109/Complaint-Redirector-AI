APP_ENV=development
# Production PostgreSQL URLs must include ?sslmode=require.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database>
# Generate random secret material for production; this value is intentionally blank.
JWT_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOGIN_LOCKOUT_ENABLED=false
# Required in production; keep separate from JWT_SECRET_KEY.
LOGIN_LOCKOUT_HMAC_KEY=
GROQ_API_KEY=
CHATBOT_AUDIT_WORKBOOK=backend/logs/chatbot_audit.xlsx
CHATBOT_AUDIT_EXPORT_BATCH_SIZE=100
CHATBOT_AUDIT_EXPORT_POLL_SECONDS=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/drive/callback
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=
SMTP_PORT=587
# Set these only in the protected environment when using the provisioning script.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
